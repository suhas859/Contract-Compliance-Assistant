<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contract Compliance Assistant</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <button type="button" id="new-session-btn" class="sidebar-new-btn" title="Start a new session">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        New chat
      </button>
      <nav class="sidebar-list">
        <% sessionList.forEach(s => { %>
          <a
            href="/chat?session=<%= s.id %>"
            class="sidebar-item<%= s.id === sessionId ? ' active' : '' %>"
            data-session="<%= s.id %>"
            title="<%= s.title %>"
          ><%= s.title %></a>
        <% }) %>
      </nav>
    </aside>

    <div class="app">
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </span>
        <span class="brand-text">Contract Compliance Assistant</span>
      </div>
    </header>

    <main class="chat-window" id="chat-window">
      <% if (messages.length === 0) { %>
        <div class="empty-state">
          <h2>What contract or invoice can I check today?</h2>
          <p>Ask a policy question, or attach a contract/invoice to validate it.</p>
        </div>
      <% } %>

      <% messages.forEach(m => { %>
        <div class="row <%= m.role %>">
          <div class="avatar <%= m.role %>"><%= m.role === 'user' ? 'U' : 'A' %></div>
          <div class="bubble<%= m.isError ? ' error' : '' %>">
            <% (m.fileNames || (m.fileName ? [m.fileName] : [])).forEach(fileName => { %>
              <div class="file-tag">📎 <%= fileName %></div>
            <% }) %>
            <% if (m.text) { %><p><%= m.text %></p><% } %>
            <% if (m.citations && m.citations.length) { %>
              <div class="citations">
                <% m.citations.forEach(c => { %><span class="citation-pill"><%= c %></span><% }) %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </main>

    <% const uploadedFiles = [...new Set(messages.filter(m => m.fileName).map(m => m.fileName))]; %>
    <div id="uploaded-files-strip" class="uploaded-files-strip<%= uploadedFiles.length ? ' has-files' : '' %>">
      <% uploadedFiles.forEach(f => { %><span class="file-chip" data-file="<%= f %>">📎 <%= f %></span><% }) %>
    </div>

    <form action="/chat/message" method="POST" enctype="multipart/form-data" class="composer" id="composer">
      <input type="hidden" name="session" value="<%= sessionId %>">

      <div class="composer-inner">
        <textarea
          name="message"
          id="message-input"
          placeholder="Ask a question or describe what to check..."
          rows="1"
          autocomplete="off"
        ></textarea>

        <div class="composer-toolbar">
          <label for="file-upload" class="file-btn" title="Attach a contract or invoice">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.44 11.05l-9.19 9.19a5 5 0 01-7.07-7.07l9.19-9.19a3.5 3.5 0 014.95 4.95l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/>
            </svg>
          </label>
          <input type="file" id="file-upload" name="files" accept=".pdf,.docx" multiple hidden>

          <div class="composer-toolbar-spacer"></div>

          <div class="model-picker" id="model-picker">
            <button type="button" class="model-picker-btn" id="model-picker-btn" aria-haspopup="true" aria-expanded="false">
              <span class="model-dot"></span>
              <span id="model-picker-label">Ollama · llama3</span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>
            <div class="model-picker-menu" id="model-picker-menu" hidden>
              <button type="button" class="model-option selected" data-value="ollama" data-label="Ollama · llama3">
                <span class="model-option-name">Ollama · llama3</span>
                <svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </button>
              <button type="button" class="model-option disabled" data-value="openai" disabled>
                <span class="model-option-name">OpenAI</span>
                <span class="soon-tag">not connected</span>
              </button>
            </div>
          </div>

          <button type="submit" class="send-btn" title="Send">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/>
            </svg>
          </button>
        </div>
      </div>

      <div id="file-preview" class="file-preview"></div>
    </form>
    </div>
  </div>

  <script src="/chat.js"></script>
</body>
</html>
